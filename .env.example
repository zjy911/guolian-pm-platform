# ============================================================
# 环境变量样例：复制为 .env 后填写真实值，.env 不得提交到仓库
# ============================================================

# ---------- 后端 ----------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# JWT：必须注入，长度 ≥ 32 位（启动时校验，缺失直接失败）
JWT_SECRET=please-replace-with-a-32-char-random-secret
JWT_ACCESS_MINUTES=120
IMPERSONATE_MAX_HOURS=2

# 数据库（MySQL 8.0）
DB_HOST=mysql
DB_PORT=3306
DB_NAME=pm_platform
DB_USER=pm
DB_PASSWORD=please-replace
DB_POOL_MAX=20

# 缓存（生产用 Redis）
CACHE_TYPE=redis
CACHE_TTL_SECONDS=300
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 前端来源（必须显式列出，禁止通配符）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# 调试模拟（PROD 默认关闭）
DEBUG_IMPERSONATE_ENABLED=false

# 交接参数
TRANSFER_REVOKE_DAYS=7
TRANSFER_BATCH_SIZE=200
TRANSFER_MAX_ITEMS=5000

# 附件目录
UPLOAD_DIR=/data/uploads

# ---------- 前端 ----------
# 留空时走 Vite 代理 / 同源反向代理
VITE_API_BASE_URL=/api/v1
VITE_API_TARGET=http://127.0.0.1:8080
